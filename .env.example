# Puerto del servidor. 8080 es el default en app.js y el que usan los scripts.
PORT=8080

# ==========================================
# Base de datos (REQUERIDO)
# ==========================================
# Supabase, del panel del proyecto: Settings > Database > Connection string.
#
# Dos avisos que cuestan tiempo si no se respetan (ver AGENTS.md, "Trampas"):
#
#  1. Usar el POOLER TRANSACCIONAL, puerto 6543, host aws-0-*.pooler.supabase.com.
#     El "Direct connection" (db.<ref>.supabase.co) es IPv6-only en el free tier
#     y no se puede usar. Regla: si el host dice `pooler.supabase.com` sirve; si
#     dice `db.`, no.
#
#  2. SIN `?sslmode=require` al final. La doc de Supabase dice ponerlo, pero con
#     pg 8.16.3 ese parametro resuelve a ssl.rejectUnauthorized = true, pisa el
#     `ssl` del pool y toda query falla con:
#       Error: self-signed certificate in certificate chain
#     El TLS se configura en server/db.js, no en la string.
#
# OJO: si esta variable falta, db.js cae a `postgresql://localhost/festival_match`.
# Y `dotenv.config()` en app.js pisa lo que exporte el shell, así que un
# `npm start` local sin esto se conecta a la base que diga el .env.

DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-2.pooler.supabase.com:6543/postgres

# ==========================================
# Google OAuth (REQUERIDO para login)
# ==========================================
# Obtener en: https://console.cloud.google.com/apis/credentials
# 1. Crear proyecto (o usar existente)
# 2. APIs & Services > Credentials > Create OAuth Client ID
# 3. Application type: Web application
# 4. Authorized redirect URIs: http://localhost:8080/auth/google/callback
#
# En producción el redirect URI apunta al dominio de Vercel, NO a localhost.
# El secret es el mismo en el .env local y en Vercel.

GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# ==========================================
# Last.fm API (OPCIONAL)
# ==========================================
# Sin esta var no funciona la importación de artistas desde Last.fm.
# Obtener en: https://www.last.fm/api/account/create

LASTFM_API_KEY=tu_lastfm_api_key

# ==========================================
# Roles de admin (OPCIONAL)
# ==========================================
# Lista separada por comas de emails con role = 'admin,dev'. Sin esta var el
# fallback hardcodeado es nelsoncabrera06@gmail.com. Se aplica en
# findOrCreateUser(), o sea que alcanza con reiniciar: no hace falta migración.

ADMIN_EMAILS=nelsoncabrera06@gmail.com

# ==========================================
# Spotify API (opcional; importar top artists)
# ==========================================
# Crear una app en https://developer.spotify.com/dashboard y registrar el redirect URI
# local y el de producción en sus settings. Generar la clave de cifrado con:
#   openssl rand -base64 32
SPOTIFY_CLIENT_ID=tu_spotify_client_id
SPOTIFY_CLIENT_SECRET=tu_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/auth/spotify/callback
SPOTIFY_TOKEN_ENCRYPTION_KEY=clave_base64_de_32_bytes
