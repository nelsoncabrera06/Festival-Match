# Dependencias
node_modules/

# Variables de entorno (contiene secrets)
.env
.env.local
.env.*.local

# JSON de credenciales que descarga el Google Cloud Console al crear un OAuth
# client. Trae el client_secret adentro. NUNCA commitear: el repo es publico.
client_secret_*.json

# Base de datos SQLite
*.db
*.sqlite
*.sqlite3
server/*.db
*.dump
# NO ignorar /migrations: el schema está versionado a propósito. El backup de Cloud
# SQL (.dump) ya queda afuera por la regla global de arriba. La regla /migrations
# que había acá se oponía a eso y dejaba las migraciones nuevas sin trackear.

# Logs
logs/
*.log
npm-debug.log*

# Sistema operativo
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Build
dist/
build/

# Local/desarrollo
/dev_local
/google_cloud 

# Plan de trabajo local (plan.md + el HTML generado). Es de Nelson, no del repo:
# la fuente de verdad del estado del proyecto es AGENTS.md.
/agent-plan 

# AI / Claude Code
.claude/
brain_export/

# images flyers
public/images/

#db backups
*.sql

# ...pero las migraciones SI son codigo, no backups. Sin esta excepcion el
# `*.sql` de arriba se come migrations/ y el schema no queda versionado.
!migrations/*.sql

# .github
#.github/workflows/