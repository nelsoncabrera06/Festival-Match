# Dependencias
node_modules/

# Variables de entorno (contiene secrets)
.env
.env.local
.env.*.local

# JSON de credenciales que descarga el Google Cloud Console al crear un OAuth
# client. Trae el client_secret adentro. NUNCA commitear: el repo es publico.
client_secret_*.json

# Base de datos SQLite
*.db
*.sqlite
*.sqlite3
server/*.db
*.dump

# Logs
logs/
*.log
npm-debug.log*

# Sistema operativo
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Build
dist/
build/

# Local/desarrollo
/dev_local
/google_cloud 

# AI / Claude Code
.claude/
brain_export/

# images flyers
public/images/

#db backups
*.sql

# ...pero las migraciones SI son codigo, no backups. Sin esta excepcion el
# `*.sql` de arriba se come migrations/ y el schema no queda versionado.
!migrations/*.sql

# .github
#.github/workflows/