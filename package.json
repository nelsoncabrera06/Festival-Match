{
  "name": "festival-match",
  "version": "2.0.0",
  "description": "Encuentra festivales europeos que matchean con tu gusto musical",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "seed:festivals": "node scripts/generate-festivals-migration.js",
    "seed:festivals:check": "node scripts/generate-festivals-migration.js --check",
    "test:festivals": "node scripts/verify-festivals-roundtrip.js && node scripts/verify-festivals-queries.js"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "google-auth-library": "^9.0.0",
    "pg": "^8.11.0"
  }
}
